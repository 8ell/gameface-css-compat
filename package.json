{
  "name": "gameface-css-compat",
  "version": "0.2.0",
  "description": "Rewrite modern CSS into exact equivalents that Coherent Gameface can render, and report what it cannot.",
  "keywords": [
    "gameface",
    "coherent",
    "coherent-labs",
    "cohtml",
    "postcss-plugin",
    "stylelint-plugin",
    "vite-plugin",
    "game-ui",
    "css"
  ],
  "license": "MIT",
  "author": "Hyeonjong Yang (https://github.com/8ell)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8ell/gameface-css-compat.git"
  },
  "homepage": "https://github.com/8ell/gameface-css-compat#readme",
  "bugs": {
    "url": "https://github.com/8ell/gameface-css-compat/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "gameface-css-compat": "src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./postcss": "./src/postcss.js",
    "./stylelint": "./src/stylelint.js",
    "./vite": "./src/vite.js",
    "./coverage": "./src/coverage.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "SECURITY.md",
    "docs/coverage.md"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.js test/unit/*.test.js",
    "test:browser": "node --test --test-reporter=spec test/browser/*.test.js",
    "coverage:docs": "node src/cli.js coverage --markdown docs/coverage.md",
    "sync": "node scripts/sync-upstream.js"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "eslint-plugin-gameface": "^1.3.1",
    "postcss": "^8.5.0",
    "postcss-nesting": "^13.0.2",
    "postcss-selector-parser": "^7.1.0",
    "postcss-value-parser": "^4.2.0"
  },
  "peerDependencies": {
    "postcss-scss": "^4.0.0",
    "stylelint": "^16.0.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "postcss-scss": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.26.1",
    "vite": "^6.4.5"
  }
}
